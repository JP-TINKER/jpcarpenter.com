---
/** TINKER-SCOPE Model 1A, functional delight island.
 *  Job: report scroll velocity as frequency; knobs change real waveform params.
 *  Progressive: static CRT frame without JS; respects prefers-reduced-motion.
 */
---

<div class="scope-sticky" id="scopeFloat">
  <div class="scope-body">
    <div class="scope-brand">
      <span class="scope-brand-name">TINKER-SCOPE</span>
      <span class="scope-brand-model"
        >Model 1A &nbsp;•&nbsp; <span id="scopeHz">500Hz</span></span
      >
    </div>

    <div class="scope-crt-housing">
      <div class="scope-crt-bezel">
        <div class="scope-crt-inner">
          <canvas id="scopeCanvas" width="340" height="340" aria-label="Oscilloscope display"
          ></canvas>
        </div>
      </div>
      <div class="scope-crt-screws" aria-hidden="true">
        <div class="scope-crt-screw tl"></div>
        <div class="scope-crt-screw tr"></div>
        <div class="scope-crt-screw bl"></div>
        <div class="scope-crt-screw br"></div>
      </div>
    </div>

    <div class="scope-panel">
      <div class="scope-readout-strip">
        <div class="scope-readout-val active">3.3V</div>
        <div class="scope-readout-val">DC</div>
        <div class="scope-readout-val">CH1</div>
      </div>
      <div class="scope-knobs">
        <div class="knob" data-knob="vol" title="Drag up/down: amplitude">
          <div class="knob-circle" id="knobVol"></div>
          <div class="knob-label">Vol</div>
        </div>
        <div class="knob" data-knob="time" title="Drag up/down: frequency">
          <div class="knob-circle" id="knobTime"></div>
          <div class="knob-label">Time</div>
        </div>
        <div class="knob" data-knob="trig" title="Drag up/down: trigger">
          <div class="knob-circle" id="knobTrig"></div>
          <div class="knob-label">Trig</div>
        </div>
        <div class="knob" data-knob="gain" title="Drag up/down: brightness">
          <div class="knob-circle" id="knobGain"></div>
          <div class="knob-label">Gain</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initTinkerScope } from '../scripts/tinker-scope';
  initTinkerScope();
</script>
