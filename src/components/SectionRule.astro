---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="section-rule">
  <div class="section-rule-inner">
    <div class="rule-line"></div>
    <div class="rule-ornament" aria-hidden="true">✦</div>
    <div class="rule-label">{label}</div>
    <div class="rule-ornament" aria-hidden="true">✦</div>
    <div class="rule-line"></div>
  </div>
</div>
