---
/** EXPOSURE GAUGE Model 1 — reads real, already-passive browser/device signals on load
 *  and reports how identifying they are. Nothing computed here is sent anywhere.
 *  Progressive: static gauge frame without JS; with JS, tap the face or a readout to
 *  slide a plain-English plate down the bay. Respects prefers-reduced-motion.
 */
---

<div class="scope-sticky" id="exposureGaugeFloat">
  <div class="gauge-stage" id="gaugeRoot">
    <div class="scope-body">
      <div class="scope-brand">
        <span class="scope-brand-name">EXPOSURE GAUGE</span>
        <span class="scope-brand-model">Model 1 &nbsp;&bull;&nbsp; tap face or readout</span>
      </div>

      <button
        type="button"
        class="scope-crt-hit"
        id="gaugeFaceBtn"
        data-explain="gauge.overview"
        aria-pressed="false"
        aria-controls="gaugeDrawer"
        aria-label="Explain what this gauge is measuring"
      >
        <div class="scope-crt-housing">
          <div class="scope-crt-bezel">
            <div class="scope-crt-inner">
              <canvas id="exposureCanvas" width="340" height="340" aria-label="Passive exposure gauge"
              ></canvas>
            </div>
          </div>
          <div class="scope-crt-screws" aria-hidden="true">
            <div class="scope-crt-screw tl"></div>
            <div class="scope-crt-screw tr"></div>
            <div class="scope-crt-screw bl"></div>
            <div class="scope-crt-screw br"></div>
          </div>
        </div>
      </button>

      <div class="scope-panel">
        <div class="gauge-readout-strip">
          <button type="button" class="gauge-readout-item gauge-readout-hit" data-explain="gauge.signals" aria-pressed="false" aria-controls="gaugeDrawer">
            <span class="gauge-readout-label">Signals</span>
            <span class="gauge-readout-val" id="gaugeScore2">0/8</span>
          </button>
          <button type="button" class="gauge-readout-item gauge-readout-hit" data-explain="gauge.reading" aria-pressed="false" aria-controls="gaugeDrawer">
            <span class="gauge-readout-label">Reading</span>
            <span class="gauge-readout-val gauge-band-low" id="gaugeRating2">LOW</span>
          </button>
          <button type="button" class="gauge-readout-item gauge-readout-hit" data-explain="gauge.note" aria-pressed="false" aria-controls="gaugeDrawer">
            <span class="gauge-readout-label">Note</span>
            <span class="gauge-readout-val" id="gaugeAction2">-</span>
          </button>
        </div>
        <button type="button" class="gauge-detected gauge-detected-hit" id="exposureDetected" data-explain="gauge.detected" aria-pressed="false" aria-controls="gaugeDrawer">
          Reading what this page can already see&hellip;
        </button>
      </div>
    </div>

    <aside
      class="instr-drawer instr-drawer--down"
      id="gaugeDrawer"
      aria-hidden="true"
      aria-labelledby="gaugeDrawerTitle"
    >
      <div class="instr-drawer-plate">
        <div class="instr-drawer-rail" aria-hidden="true"></div>
        <header class="instr-drawer-head">
          <h3 class="instr-drawer-title" id="gaugeDrawerTitle">Exposure</h3>
          <button type="button" class="instr-drawer-close" id="gaugeDrawerClose" aria-label="Close explanation">
            stow
          </button>
        </header>
        <dl class="instr-drawer-copy">
          <div>
            <dt>What</dt>
            <dd id="gaugeDrawerWhat"></dd>
          </div>
          <div>
            <dt>How</dt>
            <dd id="gaugeDrawerHow"></dd>
          </div>
          <div>
            <dt>Means</dt>
            <dd id="gaugeDrawerMeans"></dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</div>

<script>
  import { initExposureGauge } from '../scripts/exposure-gauge';
  initExposureGauge();
</script>
