---
interface Props {
  class?: string;
  title?: string;
}

const { class: className = 'brand-mark', title = 'JP Carpenter' } = Astro.props;
---

{/* Soft Block face only — no dark plate square / outer slab fill. */}
<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="96 140 320 240"
  role="img"
  aria-label={title}
>
  <title>{title}</title>
  <rect
    x="100"
    y="144"
    width="312"
    height="232"
    rx="36"
    fill="#b8c9c4"
    stroke="#3d4a46"
    stroke-width="8"></rect>
  <text
    x="256"
    y="292"
    text-anchor="middle"
    fill="#161c1b"
    font-family="Atkinson Hyperlegible, Segoe UI, Helvetica, Arial, sans-serif"
    font-size="118"
    font-weight="700"
    letter-spacing="-0.08em">JP</text>
  <rect x="160" y="322" width="192" height="6" rx="3" fill="#c47a3a"></rect>
</svg>
