---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Writing" description="Posts from the bench, when there are any.">
  <article class="page-main">
    <h1>Writing</h1>
    {
      entries.length === 0 && (
        <p>Nothing published yet — check back soon.</p>
      )
    }
  </article>

  {
    entries.length > 0 && (
      <ul class="bench-list bench-list--writing">
        {entries.map((entry) => (
          <li>
            <a href={`/writing/${entry.id}`}>
              <span class="bench-list-stamp">{entry.data.date.toISOString().slice(0, 10)}</span>
              <span class="bench-list-title">
                {entry.data.title}
                <span class="bench-list-summary">{entry.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
