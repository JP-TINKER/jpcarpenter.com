---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceEntry from '../../components/EvidenceEntry.astro';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<BaseLayout
  title="Writing"
  view="Writing"
  bluf={
    entries.length === 0
      ? 'Nothing published yet. Empty is honest.'
      : 'Specific claims only — published when one is worth defending.'
  }
  description="Writing by JP Carpenter — sparse claims only."
>

  {
    entries.length > 0 && (
      <ul class="entries sheet-full">
        {entries.map((entry, i) => (
          <EvidenceEntry
            href={`/writing/${entry.id}`}
            index={pad(i)}
            title={entry.data.title}
            finding={entry.data.description}
            stamp="Published"
            date={isoDate(entry.data.date)}
          />
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .sheet-full {
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0 0 5rem;
  }
</style>
