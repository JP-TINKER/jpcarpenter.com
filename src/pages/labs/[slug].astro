---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinkerScope from '../../components/TinkerScope.astro';
import RiskGauge from '../../components/RiskGauge.astro';
import ExposureGauge from '../../components/ExposureGauge.astro';
import FingerprintTrace from '../../components/FingerprintTrace.astro';
import { LAB_DISCIPLINE_META } from '../../lib/lab-disciplines';

export async function getStaticPaths() {
  const entries = await getCollection('labs');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Frontmatter dates parse as midnight UTC; formatting in local time would print the
// previous day west of Greenwich. An entry's date is a record, so it renders as written.
const dateLabel = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Real word count from the entry body, not a placeholder estimate.
const wordCount = entry.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
---

<BaseLayout title={entry.data.title} description={entry.data.summary} marker>
  <article class="page-main lab-detail">
    <div class="lab-detail-meta">
      {
        entry.data.stamp && (
          <span class="margin-note-stamp" data-state={entry.data.state}>
            {entry.data.stamp}
          </span>
        )
      }
      <span>{LAB_DISCIPLINE_META[entry.data.discipline].label}</span>
      <time>{dateLabel}</time>
      <span>{readingMinutes} min read</span>
      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <ul class="lab-detail-tags">
            {entry.data.tags.map((tag: string) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
    <h1>{entry.data.title}</h1>

    {
      entry.id === 'tinker-scope' && (
        <div class="lab-instrument">
          <TinkerScope />
          <p class="lab-instrument-caption">
            What it does: canvas rendering + real-time input handling, driven by hand-rolled
            pointer and scroll listeners. The knobs and scroll-coupling aren't tied to anything
            else on the site. This widget is the project.
          </p>
        </div>
      )
    }

    {
      entry.id === 'risk-gauge' && (
        <div class="lab-instrument">
          <RiskGauge />
          <p class="lab-instrument-caption">
            Turn the knobs. The needle and the readout below it are both driven by the same
            computed score (Likelihood &times; Impact), not two things pretending to agree.
          </p>
        </div>
      )
    }

    {
      entry.id === 'browser-exposure' && (
        <>
          <p class="page-lede">
            Fingerprinting is a way a website can recognize your specific browser without asking
            you and without setting a cookie. It reads a handful of harmless-looking details your
            browser hands over on every visit: screen size, installed fonts, time zone, the
            way your computer draws text. Together they form a label that's nearly
            unique to you. The two instruments below read those same details off your browser, right
            now, and show you exactly what they kept; nothing leaves your device.
          </p>
          <div class="lab-instrument">
            <ExposureGauge />
            <p class="lab-instrument-caption">
              Instrument 1: passive signals, read once on load. Tap the face or a readout for plain English. Nothing is transmitted.
            </p>
          </div>
          <div class="lab-instrument">
            <FingerprintTrace />
          </div>
        </>
      )
    }

    <div class="lab-detail-body">
      <Content />
    </div>

    <p><a class="btn-quiet" href="/labs">&larr; Back to Labs</a></p>
  </article>
</BaseLayout>
