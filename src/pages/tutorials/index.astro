---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarginNote from '../../components/MarginNote.astro';
import EvidenceEntry from '../../components/EvidenceEntry.astro';
import { LAB_DISCIPLINES, LAB_DISCIPLINE_META } from '../../lib/lab-disciplines';
import { plannedCampaigns, readyCampaigns } from '../../lib/training-campaigns';

// Drafts are hidden from the public listing. The discipline grouping mirrors Labs so a
// reviewer finds GRC / networking / security / instrument lessons in the same buckets.
const entries = (await getCollection('tutorials', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf(),
);
const indexedEntries = entries.map((entry, index) => ({ entry, index }));
const groups = LAB_DISCIPLINES.map((discipline) => ({
  discipline,
  ...LAB_DISCIPLINE_META[discipline],
  entries: indexedEntries.filter(({ entry }) => entry.data.discipline === discipline),
})).filter((group) => group.entries.length > 0);

const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const pad = (n: number) => String(n + 1).padStart(2, '0');
const ready = readyCampaigns();
const planned = plannedCampaigns();
---

<BaseLayout
  title="Tutorials"
  view="Tutorials"
  bluf="Follow-along labs with instruments you can pause, rewind, and decide with."
  description="Tutorials by JP Carpenter — walk-throughs and interactive security awareness lessons."
>

  {(ready.length > 0 || planned.length > 0) && (
    <section class="sy-group campaign-band" aria-labelledby="campaign-lessons">
      <h2 class="sy-h" id="campaign-lessons">Interactive lessons</h2>
      <p class="campaign-bluf">
        Company-ready awareness drills. Manager kits live under Resources — home still leads with analyst identity, not downloads.
      </p>
      <div class="sy-panel">
        {ready.map((c) => (
          <a class="sy-row sy-row--link" href={c.lessonHref}>
            <div>
              <p class="sy-row-label">{c.title}</p>
              <p class="sy-row-caption">{c.tagline}</p>
            </div>
            <span class="sy-row-status" data-mark="held">Lesson</span>
          </a>
        ))}
        {planned.map((c) => (
          <div class="sy-row">
            <div>
              <p class="sy-row-label">{c.title}</p>
              <p class="sy-row-caption">{c.tagline}</p>
            </div>
            <span class="sy-row-status" data-mark="open">Planned</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {entries.length === 0 && (
    <section class="band sheet">
      <MarginNote />
      <p class="band-lede">Nothing published here yet.</p>
    </section>
  )}

  {
    groups.map((group) => (
      <section class="lab-domain">
        <div class="sheet domain-heading">
          <MarginNote stamp={group.label} note={`${group.entries.length} published`} />
          <div>
            <h2>{group.label}</h2>
            <p>{group.description}</p>
          </div>
        </div>
        <ul class="entries sheet-full">
          {group.entries.map(({ entry, index }) => (
            <EvidenceEntry
              href={`/tutorials/${entry.id}`}
              index={pad(index)}
              title={entry.data.title}
              finding={entry.data.finding ?? entry.data.summary}
              stamp={entry.data.stamp ?? 'Walkthrough'}
              state={entry.data.state}
              discipline={group.label}
              date={isoDate(entry.data.date)}
            />
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .campaign-band {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3rem) var(--pad) 0;
  }

  .campaign-bluf {
    margin: 0 0 0.85rem;
    max-width: 40rem;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .sheet-full {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--pad);
  }

  .lab-domain {
    padding-top: clamp(2.75rem, 6vw, 4.5rem);
  }

  .lab-domain:last-child {
    padding-bottom: 5rem;
  }

  .domain-heading h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    margin-bottom: 0.45rem;
  }

  .domain-heading p {
    color: var(--ink-muted);
    max-width: 38rem;
  }
</style>
