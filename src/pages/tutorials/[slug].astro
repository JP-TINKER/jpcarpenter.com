---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailHeaderReader from '../../components/EmailHeaderReader.astro';
import AuthenticatedPhishingDrill from '../../components/AuthenticatedPhishingDrill.astro';
import BrandStamp from '../../components/BrandStamp.astro';
import { LAB_DISCIPLINE_META } from '../../lib/lab-disciplines';
import { brandedDescription } from '../../lib/brand';
import { TRAINING_CAMPAIGNS } from '../../lib/training-campaigns';

export async function getStaticPaths() {
  // Drafts get no route, they're hidden until ready.
  const entries = await getCollection('tutorials', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Frontmatter dates parse as midnight UTC; formatting in local time would print the
// previous day west of Greenwich. A tutorial's date is a record, so it renders as written.
const dateLabel = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Real word count from the entry body, not a placeholder estimate.
const wordCount = entry.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const campaign = TRAINING_CAMPAIGNS.find((c) => c.lessonSlug === entry.id);
const pageDescription = brandedDescription(entry.data.summary);
---

<BaseLayout title={entry.data.title} description={pageDescription} marker>
  <article class="page-main lab-detail">
    <div class="lab-detail-meta">
      {
        entry.data.stamp && (
          <span class="margin-note-stamp" data-state={entry.data.state}>
            {entry.data.stamp}
          </span>
        )
      }
      <span>{LAB_DISCIPLINE_META[entry.data.discipline].label}</span>
      <time>{dateLabel}</time>
      <span>{readingMinutes} min read</span>
      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <ul class="lab-detail-tags">
            {entry.data.tags.map((tag: string) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
    <h1>{entry.data.title}</h1>

    {
      entry.id === 'reading-email-headers' && (
        <>
          <p class="page-lede">
            By the end of this page you can take a suspicious email, read three
            lines of its header, and decide whether to block it or trust it, with no paid tool. We will walk through one real phishing email, redacted, that is already loaded in the reader below.
          </p>
          <EmailHeaderReader />
        </>
      )
    }

    {
      entry.id === 'authenticated-phishing' && (
        <>
          <p class="page-lede">
            Authentication can pass and the message can still be a phish. Mark the red flags,
            choose report / verify out of band / escalate, then read the debrief.
            {campaign?.kitHref && (
              <>
                {' '}
                Managers: use the{' '}
                <a href={campaign.kitHref}>campaign kit</a> for rollout.
              </>
            )}
          </p>
          <AuthenticatedPhishingDrill />
        </>
      )
    }

    <div class="lab-detail-body">
      <Content />
    </div>

    <BrandStamp compact />

    <p><a class="btn-quiet" href="/tutorials">&larr; Back to Tutorials</a></p>
  </article>
</BaseLayout>
