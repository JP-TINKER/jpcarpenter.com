---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarginNote from '../components/MarginNote.astro';
import { getCollection, render } from 'astro:content';
import { formatLastReviewed } from '../lib/site-meta';

const entries = (await getCollection('security'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => (a.data.order ?? 50) - (b.data.order ?? 50) || +b.data.date - +a.data.date);

const notes = entries
  .filter((e) => e.data.kind === 'note')
  .sort((a, b) => +b.data.date - +a.data.date);
const controls = entries.filter((e) => e.data.kind === 'control');
const refuse = entries.filter((e) => e.data.kind === 'refuse');

const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { id: entry.id, Content, data: entry.data };
  }),
);
const byId = Object.fromEntries(rendered.map((r) => [r.id, r]));
---

<BaseLayout
  title="Security"
  view="Security"
  bluf="No login, no submitting forms, no database, no third-party tracking. On-page fill sheets do not post. Site posture in plain language."
  description="How jpcarpenter.com is protected — JP Carpenter. Static-first, strict browser rules, AI crawl policy."
>

  <section class="band sheet">
    <MarginNote stamp="Read" note="Skim first" />
    <div class="prose">
      <h2>How to read this page</h2>
      <p>
        Skim the labels. Open a row when you want the explanation. Field notes are dated
        posts about what changed. Technical evidence of verification craft lives in
        <a href="/labs">Labs</a>.
      </p>
      <p>
        Add a field note with <code>npm run new -- security "Your title"</code> — no need to
        edit this page file.
      </p>
    </div>
  </section>

  {
    notes.length > 0 && (
      <section class="band sheet">
        <MarginNote stamp="Notes" note="Field posts" state="verified" />
        <div class="prose security-teach">
          <h2>Field notes</h2>
          <p>Short dated posts.</p>
          <div class="expand-stack">
            {notes.map((entry) => {
              const R = byId[entry.id];
              return (
                <details class="expand-item">
                  <summary class="expand-term">
                    {entry.data.date.toISOString().slice(0, 10)} — {entry.data.title}
                  </summary>
                  <div class="expand-body prose-md">
                    <p class="note-summary">{entry.data.summary}</p>
                    <R.Content />
                  </div>
                </details>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <section class="band sheet">
    <MarginNote stamp="In force" note={`Reviewed ${formatLastReviewed()}`} state="verified" />
    <div class="prose security-teach">
      <h2>Controls in force</h2>
      <p>These are live choices for this website. Open any row for the lesson and citations.</p>
      <div class="expand-stack">
        {
          controls.map((entry) => {
            const R = byId[entry.id];
            return (
              <details class="expand-item">
                <summary class="expand-term">{entry.data.summary}</summary>
                <div class="expand-body prose-md">
                  <R.Content />
                  {entry.data.limits && (
                    <p>
                      <strong>Limits:</strong> {entry.data.limits}
                    </p>
                  )}
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="band sheet">
    <MarginNote stamp="Refuse" note="On purpose" />
    <div class="prose security-teach">
      <h2>What we refuse</h2>
      <div class="expand-stack">
        {
          refuse.map((entry) => {
            const R = byId[entry.id];
            return (
              <details class="expand-item">
                <summary class="expand-term">{entry.data.summary}</summary>
                <div class="expand-body prose-md">
                  <R.Content />
                </div>
              </details>
            );
          })
        }
      </div>
      <p class="last-reviewed">
        <em>Last reviewed: {formatLastReviewed()}.</em>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .security-teach {
    max-width: 40rem;
  }

  .security-teach .expand-stack {
    margin-top: 1.25rem;
  }

  .note-summary {
    margin-top: 0;
    opacity: 0.85;
  }

  .last-reviewed {
    margin-top: 1.5rem;
  }

  .prose-md :global(pre) {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    font-family: var(--font-mono, "Space Mono", ui-monospace, monospace);
    font-size: 0.85rem;
    line-height: 1.45;
    background: color-mix(in srgb, var(--ink, #1c1a16) 4%, transparent);
    border-left: 2px solid var(--sage, #64705b);
  }

  .prose-md :global(ul) {
    padding-left: 1.25rem;
  }
</style>
