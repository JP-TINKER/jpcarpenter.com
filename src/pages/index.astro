---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FREE_PRODUCTS } from '../lib/product-catalog';
import { RESOURCE_CATALOG, RESOURCE_KIND_LABEL } from '../lib/resource-catalog';

const products = [...FREE_PRODUCTS].sort((a, b) => a.order - b.order);
const companionForms = RESOURCE_CATALOG.filter(
  (r) => r.status === 'ready' && r.kind !== 'policy' && r.kind !== 'pack',
).sort((a, b) => a.order - b.order);
---

<BaseLayout
  view="Home"
  bluf="Security and Compliance Analyst. Read what you sign."
  description="JP Carpenter — Security and Compliance Analyst. PCI DSS, SOC 2, ISO 27001. Closes gaps between signed controls and running systems."
  kickers={['PCI DSS', 'SOC 2', 'ISO 27001']}
>
  <p class="home-lede">
    Hire me when policy, questionnaires, and dashboards need to match what the systems
    actually do — with evidence a reviewer can check.
  </p>

  <p class="home-cta">
    <a class="btn-primary" href="/about">Path and credentials</a>
    <a class="btn-quiet" href="mailto:jp@jpcarpenter.com">jp@jpcarpenter.com</a>
  </p>

  <section class="sy-group" aria-labelledby="proof-h">
    <h2 class="sy-h" id="proof-h">How I work (free proof)</h2>
    <p class="home-section-bluf">
      Open packs that show judgment: which program this quarter, what to track, and where the
      honest limits are. Built for founders — useful as a hiring sample of how I think.
    </p>
    <div class="sy-panel">
      {
        products.map((p) => (
          <a class="sy-row sy-row--link" href={p.href}>
            <div>
              <p class="sy-row-label">{p.title}</p>
              <p class="sy-row-caption">{p.tagline}</p>
            </div>
            <span class="sy-row-status" data-mark={p.status === 'ready' ? 'held' : 'open'}>
              {p.status === 'ready' ? 'Free' : 'Planned'}
            </span>
          </a>
        ))
      }
    </div>
    <p class="home-more">
      <a href="/products">All free products</a>
      ·
      <a href="/labs">Evidence labs</a>
    </p>
  </section>

  <section class="sy-group" aria-labelledby="resources-h">
    <h2 class="sy-h" id="resources-h">Deadline forms</h2>
    <p class="home-section-bluf">
      Panic downloads when something is due — companions to the starter pack, not a policy library.
    </p>
    <div class="sy-panel">
      {
        companionForms.map((entry) => (
          <a class="sy-row sy-row--link" href={`/resources/${entry.id}`}>
            <div>
              <p class="sy-row-label">{entry.title}</p>
              <p class="sy-row-caption">{entry.summary}</p>
            </div>
            <span class="sy-row-status" data-mark="held">
              {RESOURCE_KIND_LABEL[entry.kind]}
            </span>
          </a>
        ))
      }
    </div>
    <p class="home-more">
      <a href="/resources">All resources</a>
    </p>
  </section>
</BaseLayout>

<style>
  .home-lede {
    margin: 0 0 1.25rem;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--ink-body);
  }

  .home-section-bluf {
    margin: -0.35rem 0 0.75rem;
    font-size: 0.9375rem;
    color: var(--ink-body);
  }

  .home-more {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
  }

  .home-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    align-items: center;
    margin: 0 0 2rem;
  }
</style>
