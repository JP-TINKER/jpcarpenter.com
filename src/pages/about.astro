---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import MarginNote from '../components/MarginNote.astro';

// Headshot slot: reserved, not required. Drop a file at public/about/headshot.{webp,jpg,jpeg,png}
// and rebuild - it appears framed below, plain, no code change needed. Absent, this renders
// nothing; there is no broken-image state either way. See src/content/README.md and the root
// README's "Adding content" section for the convention.
const headshotExts = ['webp', 'jpg', 'jpeg', 'png'];
const headshotExt = headshotExts.find((ext) =>
  existsSync(fileURLToPath(new URL(`../../public/about/headshot.${ext}`, import.meta.url))),
);
const headshotSrc = headshotExt ? `/about/headshot.${headshotExt}` : null;
---

<BaseLayout
  title="About"
  description="Security and compliance analyst. PCI DSS, SOC 2, ISO 27001: closing the gap between what a control says and what the system does."
>
  <div itemscope itemtype="https://schema.org/Person">
    <!-- Microdata, not JSON-LD: the site's CSP forbids inline <script> without a hash, so
         entity facts for Google/AI crawlers live as itemprop attributes on real HTML
         instead of a script block. Values mirror the visible text, not invented ones. -->
    <meta itemprop="name" content="Joe Carpenter" />
    <meta itemprop="alternateName" content="JP Carpenter" />
    <meta itemprop="jobTitle" content="Security and Compliance Analyst" />
    <meta itemprop="email" content="joe@jpcarpenter.com" />
    <meta itemprop="url" content="https://jpcarpenter.com/about" />
  <section class="band sheet">
    <MarginNote index="04" stamp="About" note="Work first · then path" />
    <div>
      <h1 class="band-heading">About</h1>
      {
        headshotSrc && (
          <figure class="about-photo">
            <img src={headshotSrc} alt="Joe Carpenter" width="220" height="220" loading="eager" />
          </figure>
        )
      }
      <p class="band-lede">
        Security and compliance analyst for teams that need controls, evidence, and audit
        readiness to match what the systems actually do.
      </p>
    </div>
  </section>

  <section class="band sheet">
    <MarginNote stamp="Now" note="briskData · since Feb 2026" state="verified" />
    <div class="prose">
      <h2>What the work looks like</h2>
      <p>
        At briskData I work as a contractor under the title Compliance Manager. Recent work
        includes:
      </p>
      <ul class="proof-list">
        <li>
          Leading PCI DSS (Payment Card Industry Data Security Standard) certification work
          through evidence, control mapping, and audit readiness.
        </li>
        <li>
          Migrating the compliance program from Vanta to Scrut while keeping control and evidence
          continuity.
        </li>
        <li>
          Driving SOC 2 and ISO 27001 readiness, and supporting early ISO 42001 scoping.
        </li>
        <li>
          Authoring security policy material and building the security training used in onboarding.
        </li>
      </ul>
      <p>
        I read the control, the vendor answer, and the configuration until they agree, or I write
        down where they don't. <a href="/labs">Labs</a> carries the technical evidence behind that
        habit, with honest labels when something is still in progress.
      </p>
    </div>
  </section>

  <section class="band sheet">
    <MarginNote stamp="Before" note="shelter · education · 2025" />
    <div class="prose">
      <h2>How I got here</h2>
      <p>
        I started as a case manager at a homeless shelter, where case documentation had to match
        what had actually happened for the people we were serving. Then thirteen years as an
        educator in Taiwan: teaching and school life, not IT. Informal tech help during COVID, but
        I was not running the network. What carried forward was institutional discipline: records,
        process, and being answerable when something was wrong.
      </p>
      <p>
        In 2025 I built a self-directed security and compliance portfolio on this site, then took
        the current role in February 2026.
      </p>
    </div>
  </section>

  <section class="band sheet">
    <MarginNote stamp="Credentials" note="After the work, not before" />
    <div class="prose">
      <h2>Certifications</h2>
      <p>
        CompTIA Security+, Network+, A+, CSIS (Secure Infrastructure Specialist), and CIOS (IT
        Operations Specialist).
      </p>
      <p>
        In progress, and labeled that way until they are not: BTL1 (Blue Team Level 1) and AWS
        Cloud Practitioner.
      </p>
      <p>Bachelor of Arts, History and Chinese Language (United States).</p>
    </div>
  </section>

  <section class="closing">
    <div class="sheet closing-inner">
      <MarginNote stamp="Open" state="open" note="Plain email · no form" />
      <div>
        <h2>Reach me</h2>
        <p>
          Plain email is best: <a href="mailto:joe@jpcarpenter.com">joe@jpcarpenter.com</a>. Send
          a policy, a vendor questionnaire, or a control you are not sure is doing anything, and I
          will tell you what I would check first. No form, no funnel.
        </p>
        <div class="desk-actions">
          <a class="btn-primary" href="mailto:joe@jpcarpenter.com">joe@jpcarpenter.com</a>
          <a class="btn-quiet" href="/labs">Read the evidence</a>
        </div>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  /* Plain frame, no circle, no glow ring - same hairline treatment as the Labs evidence
     figures (global.css .lab-detail-body figure), not a portrait-hero look. */
  .about-photo {
    border: 1px solid var(--rule);
    max-width: 12rem;
    margin: 0 0 1.75rem;
  }

  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .prose {
    max-width: 38rem;
  }

  .prose h2 {
    font-size: 1.3rem;
    margin-bottom: 0.7rem;
  }

  .prose p {
    color: var(--ink-body);
    margin-bottom: 1rem;
  }

  .prose em {
    font-style: normal;
    color: var(--accent-soft);
  }

  /* Rows, not cards: proof as a numbered list that can be skimmed (Evoke/Harvard). */
  .proof-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    color: var(--ink-body);
  }

  .proof-list li {
    position: relative;
    padding: 0.65rem 0 0.65rem 2.1rem;
    border-top: 1px solid var(--rule);
  }

  .proof-list li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .proof-list li::before {
    position: absolute;
    left: 0;
    top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--accent-soft);
    content: counter(proof, decimal-leading-zero);
    counter-increment: proof;
  }

  .proof-list {
    counter-reset: proof;
  }
</style>
