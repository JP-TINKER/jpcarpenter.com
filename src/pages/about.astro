---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import MarginNote from '../components/MarginNote.astro';

const headshotExts = ['webp', 'jpg', 'jpeg', 'png'];
const headshotExt = headshotExts.find((ext) =>
  existsSync(fileURLToPath(new URL(`../../public/about/headshot.${ext}`, import.meta.url))),
);
const headshotSrc = headshotExt ? `/about/headshot.${headshotExt}` : null;
---

<BaseLayout
  title="About"
  view="About"
  bluf="Security and Compliance Analyst. I close gaps between signed controls and running systems."
  description="JP Carpenter — Security and Compliance Analyst. PCI DSS, SOC 2, ISO 27001. Path, work, credentials."
>
  <div itemscope itemtype="https://schema.org/Person">
    <meta itemprop="name" content="JP Carpenter" />
    <meta itemprop="jobTitle" content="Security Analyst" />
    <meta itemprop="email" content="jp@jpcarpenter.com" />
    <meta itemprop="url" content="https://jpcarpenter.com/about" />
    <link itemprop="sameAs" href="https://www.linkedin.com/in/joseph-carpenter-597487271" />
    <link itemprop="sameAs" href="https://github.com/JP-TINKER" />

    <section class="band sheet">
      <MarginNote index="01" stamp="Role" note="Who to hire" />
      <div>
        {
          headshotSrc && (
            <figure class="about-photo">
              <img src={headshotSrc} alt="JP Carpenter" width="220" height="220" loading="eager" />
            </figure>
          )
        }
        <p class="band-lede">
          Hire me when policy, questionnaires, and dashboards need to match what the systems
          actually do — with evidence a reviewer can check.
        </p>
        <p class="band-meta">
          Machine-readable card (same facts): <a href="/about.md">/about.md</a>
          · <a href="/terms.txt">Terms</a>
        </p>
      </div>
    </section>

    <section class="band sheet">
      <MarginNote stamp="Now" note="briskData · since Feb 2026" state="verified" />
      <div class="prose">
        <h2>Current work</h2>
        <p>Full-time Security Analyst at briskData. Recent outcomes:</p>
        <ul class="proof-list">
          <li>
            Led PCI DSS certification work: control mapping, evidence packs, and audit readiness.
          </li>
          <li>
            Migrated the compliance program from Vanta to Scrut with control and evidence continuity.
          </li>
          <li>Drove SOC 2 and ISO 27001 readiness; supported early ISO 42001 scoping.</li>
          <li>
            Authored security policy material and built the security training used in onboarding.
          </li>
        </ul>
        <p>
          Habit on every engagement: read the control, the vendor answer, and the configuration
          until they agree — or write the exception with proof. Technical checks live in
          <a href="/labs">Labs</a>, stamped Verified or Open.
        </p>
      </div>
    </section>

    <section class="band sheet">
      <MarginNote stamp="Path" note="Shelter · education · GRC" />
      <div class="prose">
        <h2>Path</h2>
        <p>
          Case management in a homeless shelter taught me that documentation must match what
          actually happened. Thirteen years as an educator in Taiwan (teaching and school life —
          not IT). Institutional discipline carried forward: records, process, and answerability
          when something is wrong.
        </p>
        <p>
          In 2025 I built a self-directed security and compliance portfolio on this site. In
          February 2026 I joined briskData; the role is now full-time Security Analyst.
        </p>
      </div>
    </section>

    <section class="band sheet">
      <MarginNote stamp="Credentials" note="After the work" />
      <div class="prose">
        <h2>Credentials</h2>
        <p>
          CompTIA Security+, Network+, A+, CSIS (Secure Infrastructure Specialist), CIOS (IT
          Operations Specialist).
        </p>
        <p>
          In progress (labeled until done): BTL1 (Blue Team Level 1), AWS Cloud Practitioner.
        </p>
        <p>B.A., History and Chinese Language (United States).</p>
      </div>
    </section>

    <section class="closing">
      <div class="sheet closing-inner">
        <MarginNote stamp="Contact" state="open" note="Plain email" />
        <div>
          <h2>Contact</h2>
          <p>
            <a href="mailto:jp@jpcarpenter.com">jp@jpcarpenter.com</a> — send a role, a policy, or
            a control you do not trust. I will say what I would check first. No form.
          </p>
          <div class="desk-actions">
            <a class="btn-primary" href="mailto:jp@jpcarpenter.com">jp@jpcarpenter.com</a>
            <a class="btn-quiet" href="/labs">Evidence labs</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-photo {
    border: 1px solid var(--rule);
    max-width: 12rem;
    margin: 0 0 1.75rem;
  }

  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .band-meta {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
    max-width: 38rem;
  }

  .band-meta a {
    font-weight: 700;
  }

  .prose {
    max-width: 38rem;
  }

  .prose h2 {
    font-size: 1.3rem;
    margin-bottom: 0.7rem;
  }

  .prose p {
    color: var(--ink-body);
    margin-bottom: 1rem;
  }

  .proof-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    color: var(--ink-body);
    counter-reset: proof;
  }

  .proof-list li {
    position: relative;
    padding: 0.65rem 0 0.65rem 2.1rem;
    border-top: 1px solid var(--rule);
  }

  .proof-list li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .proof-list li::before {
    position: absolute;
    left: 0;
    top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--accent-soft);
    content: counter(proof, decimal-leading-zero);
    counter-increment: proof;
  }

  .closing {
    margin-top: 2rem;
  }

  .closing-inner {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: var(--gutter);
    align-items: start;
  }

  .closing h2 {
    font-size: 1.3rem;
    margin-bottom: 0.7rem;
  }

  .closing p {
    color: var(--ink-body);
    margin-bottom: 1rem;
    max-width: 38rem;
  }

  .desk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .closing-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
